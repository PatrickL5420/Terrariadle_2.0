					"to": "maxFallSpeed += 0.01f;"
				},
				{
					"name": "Move_Jump_Gravity",
					"after": "public void Update(int i)",
					"from": "HorizontalMovement();",
					"to": "if (!mount.Active || mount.Type != 5)",
					"params": "int i"
				},
				{
					"name": "Move_Glide",
					"after": "public void Update(int i)",
					"from": "float num113 = 1f + Math.Abs(velocity.X) / 3f;",
					"to": "if (gfxOffY < -32f)"
				},
