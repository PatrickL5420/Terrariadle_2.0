					"name": "Move_Steps",
					"after": "public void Update(int i)",
					"from": "SlopeDownMovement();",
					"fromOffset": 2,
					"to": "Collision.StepUp(ref position, ref velocity, width, height, ref stepSpeed, ref gfxOffY, (int)gravDir, controlUp);"
				},
