# Secret that scrambles the daily answer order. Required in production: without it anyone
# could compute future answers from the public source. Any long random string works:
#   node -e "console.log(crypto.randomUUID())"
DAILY_SECRET=

# Optional: Upstash Redis for "you were the Nth person" and solve counts.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
